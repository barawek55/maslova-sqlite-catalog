<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F8F3F8" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingLeft="24dp" android:paddingTop="24dp" android:paddingRight="24dp" android:paddingBottom="32dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="♡" android:textColor="#854C76" android:textSize="36sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:fontFamily="serif" android:text="Мой каталог" android:textColor="#432744" android:textSize="34sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="Небольшая коллекция товаров" android:textColor="#765F73" android:textSize="15sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Маслова Ксения Сергеевна
Т-433901-НТ" android:textColor="#765F73" android:textSize="13sp" android:gravity="center" android:lineSpacingExtra="3dp" />
        <LinearLayout android:id="@+id/categories" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:orientation="vertical" />
        <TextView android:id="@+id/section_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="26dp" android:textColor="#432744" android:textSize="22sp" android:textStyle="bold" />
        <LinearLayout android:id="@+id/products" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
